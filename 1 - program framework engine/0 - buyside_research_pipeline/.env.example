# API keys for TickerToThesis Pipeline
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#   Then edit .env with your actual keys

# Required: Anthropic (for Claude Sonnet — analysts, RD synthesis, source summary)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required: OpenRouter (for Kimi K2 RD reviews + Perplexity Sonar source scout)
# The provider reads OPENROUTER_KIMI_KEY first, then falls back to OPENROUTER_API_KEY.
OPENROUTER_KIMI_KEY=sk-or-your-key-here

# Optional: Gemini (for light-mode human_readable polish only)
# GEMINI_API_KEY=your-key-here
